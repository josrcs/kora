# ==========================================================
#  Kora · variables de entorno (copiar como .env.local)
# ==========================================================

# PostgreSQL (node-postgres lee las variables PG* estándar)
PGHOST=localhost
PGPORT=5432
PGDATABASE=kora
PGUSER=kora_app
PGPASSWORD=cambia_esta_clave
# Esquema de trabajo (opcional; por defecto "public")
DB_SCHEMA=public

# Secreto para firmar la cookie de sesión (mín. 32 caracteres)
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=


# Costo de bcrypt para contraseñas nuevas (12 recomendado en producción)
BCRYPT_ROUNDS=12
